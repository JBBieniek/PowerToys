#include <windows.h>
#include "resource.h"
#include <common/version/version.h>
1 RT_MANIFEST "app.manifest"
1 ICON "glidezoom.ico"
1 VERSIONINFO
 FILEVERSION FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PowerToys GlideZoom\0"
   VALUE "FileVersion", FILE_VERSION_STRING
   VALUE "ProductName", "PowerToys GlideZoom\0"
   VALUE "ProductVersion", PRODUCT_VERSION_STRING
   VALUE "Comments", "Based on GlideZoom 0.6.2\0"
   VALUE "OriginalFilename", "PowerToys.GlideZoom.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
